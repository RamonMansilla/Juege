# Public app settings (set both the public and server-side commission values to the same rates)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=CLP
NEXT_PUBLIC_DEPOSIT_RATE=0.10
NEXT_PUBLIC_RAMNCO_FEE_RATE=0.03
NEXT_PUBLIC_RAMNCO_FEE_BASE=product_total

# Supabase: the anon key is safe for browser use when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never use NEXT_PUBLIC_ with this key.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago Checkout Pro marketplace credentials (seller token comes from seller OAuth).
MERCADOPAGO_SELLER_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Optional HTTPS endpoint for the store's own system. Called only after a verified payment.
SHOP_NOTIFICATION_WEBHOOK_URL=

# Server-only OpenAI configuration for the admin drafting assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Server-side fee settings; keep these in sync with the NEXT_PUBLIC_ values above.
DEPOSIT_RATE=0.10
RAMNCO_FEE_RATE=0.03
RAMNCO_FEE_BASE=product_total
